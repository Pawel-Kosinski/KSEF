# PostgreSQL
DATABASE_URL=postgresql+asyncpg://vcfo:vcfo_secret@localhost:5432/wirtualny_cfo

# JWT (MVP – w produkcji użyj silnego sekretu)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# Szyfrowanie tokenów KSeF (Fernet) – wymagane do zapisu tokenu w ustawieniach
# Wygeneruj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=

# Aplikacja
APP_NAME=Wirtualny CFO
DEBUG=true

# KSeF API 2.0 (środowisko testowe: api-test.ksef.mf.gov.pl)
KSEF_BASE_URL=https://api-test.ksef.mf.gov.pl/api/v2
KSEF_AUTH_POLL_INTERVAL_SEC=1.0
KSEF_AUTH_POLL_MAX_ATTEMPTS=60
KSEF_EXPORT_POLL_INTERVAL_SEC=2.0
KSEF_EXPORT_POLL_MAX_ATTEMPTS=120

# Ollama (lokalny SLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=45

# ETL – równoległa kategoryzacja pozycji faktury
ETL_CLASSIFICATION_CONCURRENCY=3

# Virtual CFO Chat – Amazon Bedrock (Claude 3.5 Haiku, EU)
LLM_PROVIDER=bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
BEDROCK_MODEL_ID=eu.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MAX_TOKENS=4096

# Opcjonalnie: bezpośrednie Anthropic API (LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
